# JRNYFLW dev — boots against real Postgres (5433) + Redis (6380) from docker-compose.jrnyflw.yml
# Original PGLITE/MEMORY config archived as .env.dev.pglite

AP_API_KEY="api-key"
AP_CACHE_PATH="./dev/cache"
AP_CONFIG_PATH="./dev/config"

AP_DB_TYPE=POSTGRES
AP_POSTGRES_HOST=127.0.0.1
AP_POSTGRES_PORT=5435
AP_POSTGRES_DATABASE=jrnyflw
AP_POSTGRES_USERNAME=jrnyflw
AP_POSTGRES_PASSWORD=jrnyflw_dev_password
AP_POSTGRES_USE_SSL=false

AP_QUEUE_MODE=REDIS
AP_REDIS_HOST=127.0.0.1
AP_REDIS_PORT=6381

AP_DEV_PIECES="google-sheets,store,webhook,mapper,shoprite,nucleus,schedule,sftp,subflows,tables,manual-trigger,jrny"
AP_ENVIRONMENT="dev"
AP_FRONTEND_URL="http://localhost:4200"
AP_LOG_LEVEL=debug
AP_LOG_PRETTY=true
AP_TELEMETRY_ENABLED=false
AP_TRIGGER_DEFAULT_POLL_INTERVAL=1
AP_WEBHOOK_TIMEOUT_SECONDS=30
AP_PIECES_SYNC_MODE=NONE
AP_WEBHOOK_URL="http://localhost:3010"
AP_LOAD_TRANSLATIONS_FOR_DEV_PIECES=false

AP_ENCRYPTION_KEY=ca4746386d5c6b0610613767f3ccfa8b
AP_JWT_SECRET=dev-secret-please-change-in-production

AP_QUEUE_UI_ENABLED=true
AP_QUEUE_UI_USERNAME=admin
AP_QUEUE_UI_PASSWORD=admin

