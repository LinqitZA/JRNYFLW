                          "invoiceDate": "{{step_3['item']['invoiceDate']}}",
                          "purchaseOrder": "{{step_3['item']['purchaseOrder']}}",
                          "storeGln": "{{step_3['item']['storeGln']}}",
                          "totalExclVat": "{{step_3['item']['totalExclVat']}}",
                          "totalVat": "{{step_3['item']['totalVat']}}",
                          "totalInclVat": "{{step_3['item']['totalInclVat']}}",
                          "lines": {
                            "lineNumber": "{{flattenNestedKeys(step_3, ['item', 'lines', 'lineNumber'])}}",
                            "quantity": "{{flattenNestedKeys(step_3, ['item', 'lines', 'quantity'])}}",
                            "lineTotalExclVat": "{{flattenNestedKeys(step_3, ['item', 'lines', 'lineTotalExclVat'])}}",
                            "lineTotalInclVat": "{{flattenNestedKeys(step_3, ['item', 'lines', 'lineTotalInclVat'])}}",
                            "description": "{{flattenNestedKeys(step_3, ['item', 'lines', 'description'])}}",
                            "gtin": "{{flattenNestedKeys(step_3, ['item', 'lines', 'gtin'])}}"
                          },
                          "onFailure": "continue"
                        },
                        "propertySettings": {
                          "invoiceNumber": {
                            "type": "MANUAL"
                          },
                          "invoiceDate": {
                            "type": "MANUAL"
                          },
                          "purchaseOrder": {
                            "type": "MANUAL"
