                          "lines": {
                            "type": "DYNAMIC"
                          },
                          "onFailure": {
                            "type": "MANUAL"
                          }
                        },
                        "sampleData": {},
                        "errorHandlingOptions": {
                          "retryOnFailure": {
                            "value": false
                          },
                          "continueOnFailure": {
                            "value": true
                          }
                        }
                      },
                      "nextAction": {
                        "name": "step_6",
                        "displayName": "Sent?",
                        "type": "ROUTER",
                        "valid": true,
                        "skip": false,
                        "lastUpdatedDate": "2026-10-18T19:01:15.796Z",
                        "settings": {
                          "executionType": "EXECUTE_FIRST_MATCH",
                          "branches": [
                            {
                              "branchType": "CONDITION",
                              "branchName": "Sent",
                              "conditions": [
