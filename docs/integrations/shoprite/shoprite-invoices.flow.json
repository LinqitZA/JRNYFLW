{
  "name": "Shoprite Invoices from JRNY",
  "type": "SHARED",
  "summary": "",
  "description": "Sends delivered SHOE100 invoices from 2026-10-20 on to Shoprite as GS1 invoices and records sent or failed in JRNY. UNCONFIRMED invoices are never resent automatically.",
  "tags": [],
  "blogUrl": "",
  "metadata": {
    "externalId": "shopriteInvoicesV1xxxxx"
  },
  "author": "JRNYFLW Admin",
  "categories": [],
  "pieces": [
    "@activepieces/piece-schedule",
    "@jrnyflw/shoprite",
    "@jrnyflw/jrny"
  ],
  "status": "PUBLISHED",
  "flows": [
    {
      "displayName": "Shoprite Invoices from JRNY",
      "valid": false,
      "schemaVersion": "20",
      "notes": [],
      "trigger": {
        "name": "trigger",
        "displayName": "Hourly 07:00 to 19:00",
        "type": "PIECE_TRIGGER",
        "valid": true,
        "lastUpdatedDate": "2026-10-18T19:01:15.796Z",
        "settings": {
          "pieceName": "@activepieces/piece-schedule",
          "pieceVersion": "0.1.17",
          "triggerName": "cron_expression",
          "input": {
            "cronExpression": "0 7-19 * * *",
            "timezone": "Africa/Johannesburg"
          },
          "propertySettings": {
            "cronExpression": {
              "type": "MANUAL"
            },
            "timezone": {
              "type": "MANUAL"
            }
          },
          "sampleData": {}
        },
        "nextAction": {
          "name": "step_1",
          "displayName": "List Invoices Ready to Send",
          "type": "PIECE",
          "valid": false,
          "skip": false,
          "lastUpdatedDate": "2026-10-18T19:01:15.796Z",
          "settings": {
            "pieceName": "@jrnyflw/jrny",
            "pieceVersion": "0.1.0",
            "actionName": "list_invoices_ready_to_send",
            "input": {
              "auth": "{{connections['pick-the-jrny-production-connection']}}",
              "customerCode": "SHOE100",
              "fromDate": "2026-10-20",
              "maxInvoices": 50,
              "onFailure": "stop"
            },
            "propertySettings": {
              "customerCode": {
                "type": "MANUAL"
              },
              "fromDate": {
                "type": "MANUAL"
              },
              "maxInvoices": {
                "type": "MANUAL"
              },
              "onFailure": {
                "type": "MANUAL"
              }
            },
            "sampleData": {},
            "errorHandlingOptions": {
              "retryOnFailure": {
                "value": false
              },
              "continueOnFailure": {
                "value": false
              }
            }
          },
          "nextAction": {
            "name": "step_2",
            "displayName": "Anything to send?",
            "type": "ROUTER",
            "valid": true,
            "skip": false,
            "lastUpdatedDate": "2026-10-18T19:01:15.796Z",
            "settings": {
              "executionType": "EXECUTE_FIRST_MATCH",
              "branches": [
                {
                  "branchType": "CONDITION",
                  "branchName": "Invoices to send",
                  "conditions": [
                    [
                      {
                        "operator": "NUMBER_IS_GREATER_THAN",
                        "firstValue": "{{step_1['output']['count']}}",
                        "secondValue": "0"
                      }
                    ]
                  ]
                },
                {
                  "branchType": "FALLBACK",
                  "branchName": "Otherwise"
                }
              ]
            },
            "children": [
              {
                "name": "step_3",
                "displayName": "Each invoice",
                "type": "LOOP_ON_ITEMS",
                "valid": true,
                "skip": false,
                "lastUpdatedDate": "2026-10-18T19:01:15.796Z",
                "settings": {
                  "items": "{{step_1['output']['invoices']}}"
                },
                "firstLoopAction": {
                  "name": "step_4",
                  "displayName": "Clean?",
                  "type": "ROUTER",
                  "valid": true,
                  "skip": false,
                  "lastUpdatedDate": "2026-10-18T19:01:15.796Z",
                  "settings": {
                    "executionType": "EXECUTE_FIRST_MATCH",
                    "branches": [
                      {
                        "branchType": "CONDITION",
                        "branchName": "Clean",
                        "conditions": [
                          [
                            {
                              "operator": "BOOLEAN_IS_TRUE",
                              "firstValue": "{{step_3['item']['clean']}}"
                            }
                          ]
                        ]
                      },
                      {
                        "branchType": "FALLBACK",
                        "branchName": "Otherwise"
                      }
                    ]
                  },
